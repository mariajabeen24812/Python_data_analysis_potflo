    "import numpy as np\n",
    "arr = np.array([1,2,9,4,5])\n",
    "print('mean ' , np.mean(arr))\n",
    "print('median',np.median(arr))\n",
    "print('sum',np.sum(arr))\n",
    "print('max',np.max(arr))\n",
    "print('min',np.min(arr))\n",
    "print('standard drivation',np.std(arr))"
   ]
